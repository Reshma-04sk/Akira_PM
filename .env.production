# Production Environment Template (DO NOT embed real secrets here)
ENV_STATE=production
APP_NAME="SaaS Platform"

# Backend FastAPI Settings
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
BACKEND_SECRET_KEY=__SECURE_JWT_SECRET_KEY_INJECTED_AT_RUNTIME__
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database Configuration (Placeholder - Injected via deployment orchestration)
POSTGRES_USER=__SECURE_DATABASE_USER_INJECTED_AT_RUNTIME__
POSTGRES_PASSWORD=__SECURE_DATABASE_PASSWORD_INJECTED_AT_RUNTIME__
POSTGRES_HOST=__SECURE_DATABASE_HOST_INJECTED_AT_RUNTIME__
POSTGRES_PORT=5432
POSTGRES_DB=saas_db_prod

# Frontend Configurations
VITE_API_URL=https://api.saasplatform.com
VITE_PORT=80
